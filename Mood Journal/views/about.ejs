<%- include('partials/head', { title }) %>
<%- include('partials/navbar') %>

<main class="container narrow">
  <section class="page-title">
    <p class="eyebrow">About LumaMood</p>
    <h1>Simple mood tracking for daily wellbeing.</h1>
  </section>

  <section class="card info-card">
    <div class="card-body">
      <h2>About LumaMood</h2>
      <p>LumaMood helps users track emotions, identify mood trends, and reflect on daily wellbeing.</p>
      <p>Use the dashboard to review your recent entries, compare patterns with the calendar heatmap, and build a clearer picture of how each day feels.</p>
    </div>
  </section>

  <section class="info-grid">
    <article class="card">
      <div class="card-body">
        <h3>Track emotions</h3>
        <p>Log your mood, intensity, sleep, activities, and notes in one focused entry.</p>
      </div>
    </article>
    <article class="card">
      <div class="card-body">
        <h3>Spot trends</h3>
        <p>Use summaries and the calendar heatmap to see how your mood changes over time.</p>
      </div>
    </article>
    <article class="card">
      <div class="card-body">
        <h3>Reflect daily</h3>
        <p>Write short notes that help explain what affected your wellbeing each day.</p>
      </div>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
