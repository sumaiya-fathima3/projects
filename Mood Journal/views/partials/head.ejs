<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | LumaMood</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f6f7fb;
      --surface: #ffffff;
      --ink: #202338;
      --muted: #656b80;
      --line: #dfe3ee;
      --primary: #3f6df6;
      --primary-dark: #274fce;
      --danger: #d93b3b;
      --shadow: 0 16px 40px rgba(38, 45, 75, 0.10);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      max-width: 1120px;
      margin: 0 auto;
      padding: 1rem 1.25rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-weight: 800;
      font-size: 1.15rem;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 8px;
      background: var(--primary);
      color: #fff;
    }

    .nav-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.6rem;
    }

    .container {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 2rem 0 3rem;
    }

    .narrow {
      width: min(760px, calc(100% - 2rem));
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.5rem;
      padding: 3rem 0 2rem;
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1 {
      max-width: 780px;
      margin-bottom: 0.8rem;
      font-size: clamp(2rem, 4vw, 3.7rem);
      line-height: 1.05;
    }

    h2 {
      margin-bottom: 0.2rem;
      font-size: 1.6rem;
    }

    h3 {
      margin-bottom: 0.35rem;
      font-size: 1.15rem;
    }

    .eyebrow {
      margin-bottom: 0.45rem;
      color: var(--primary-dark);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-copy,
    .page-title p,
    .entry-card p,
    .empty-state p {
      color: var(--muted);
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.55rem;
      padding: 0.7rem 1rem;
      border: 1px solid transparent;
      border-radius: 8px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .primary {
      background: var(--primary);
      color: #fff;
    }

    .primary:hover {
      background: var(--primary-dark);
    }

    .secondary {
      background: #eef2ff;
      color: var(--primary-dark);
    }

    .ghost {
      background: transparent;
      border-color: var(--line);
      color: var(--muted);
    }

    .danger {
      background: #fff1f1;
      color: var(--danger);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 2.25rem;
    }

    .stat-card,
    .entry-card,
    .mood-form,
    .detail-card,
    .empty-state,
    .card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }

    .card-body {
      padding: 1.25rem;
    }

    .stat-card {
      padding: 1.2rem;
    }

    .stat-card span {
      display: block;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .stat-card strong {
      display: block;
      margin-top: 0.4rem;
      font-size: 1.8rem;
    }

    .content-header,
    .page-title {
      margin-bottom: 1rem;
    }

    .heatmap-card {
      margin-bottom: 2.25rem;
    }

    .heatmap-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.2rem;
    }

    .heatmap-note {
      border-radius: 999px;
      background: #eef2ff;
      color: var(--primary-dark);
      padding: 0.35rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 800;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .weekday {
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 800;
      text-align: center;
      text-transform: uppercase;
    }

    .calendar-day {
      display: grid;
      place-items: center;
      min-height: 4.5rem;
      border: 1px solid rgba(255, 255, 255, 0.75);
      border-radius: 8px;
      color: #fff;
      font-weight: 800;
      box-shadow: inset 0 0 0 1px rgba(32, 35, 56, 0.06);
    }

    .calendar-day.empty {
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }

    .calendar-day.no-mood {
      color: var(--muted);
      border-color: #d8dce6;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--line);
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 700;
    }

    .legend-swatch {
      width: 0.9rem;
      height: 0.9rem;
      border-radius: 3px;
      box-shadow: inset 0 0 0 1px rgba(32, 35, 56, 0.08);
    }

    .legend-swatch.neutral {
      background: #e5e7eb;
    }

    .entry-list {
      display: grid;
      gap: 1rem;
    }

    .entry-card {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.1rem;
      border-left: 6px solid var(--primary);
    }

    .entry-main {
      display: flex;
      gap: 1rem;
      min-width: 0;
    }

    .mood-badge,
    .detail-icon {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      color: #fff;
      font-size: 1.35rem;
    }

    .mood-badge {
      width: 3rem;
      height: 3rem;
      border-radius: 8px;
    }

    .entry-date {
      margin-bottom: 0.15rem;
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 700;
    }

    .entry-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.7rem;
    }

    .entry-meta span {
      border-radius: 999px;
      background: #f1f3f8;
      color: var(--muted);
      padding: 0.3rem 0.65rem;
      font-size: 0.85rem;
    }

    .entry-actions,
    .form-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .mood-form {
      display: grid;
      gap: 1rem;
      padding: 1.25rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    label {
      display: grid;
      gap: 0.4rem;
      color: var(--ink);
      font-weight: 700;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.8rem;
      color: var(--ink);
      font: inherit;
    }

    textarea {
      min-height: 130px;
      resize: vertical;
    }

    .full {
      grid-column: 1 / -1;
    }

    .detail-card {
      border-top: 8px solid var(--primary);
      padding: 2rem;
      text-align: center;
    }

    .detail-icon {
      width: 4.5rem;
      height: 4.5rem;
      margin: 0 auto 1rem;
      border-radius: 16px;
      font-size: 2rem;
    }

    .detail-note {
      color: var(--muted);
      font-size: 1.1rem;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
      text-align: left;
    }

    .detail-grid div {
      border-radius: 8px;
      background: #f7f8fc;
      padding: 1rem;
    }

    dt {
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 700;
    }

    dd {
      margin: 0.2rem 0 0;
      font-size: 1.1rem;
      font-weight: 800;
    }

    .empty-state {
      padding: 2rem;
      text-align: center;
    }

    .info-card {
      margin-bottom: 1rem;
    }

    .info-card p,
    .info-grid p {
      color: var(--muted);
      margin-bottom: 0;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .text-link {
      color: var(--primary-dark);
      font-weight: 800;
    }

    .contact-form {
      border: 0;
      box-shadow: none;
      padding: 0;
    }

    .footer {
      border-top: 1px solid var(--line);
      color: var(--muted);
      padding: 1.5rem;
      text-align: center;
    }

    @media (max-width: 780px) {
      .hero,
      .entry-card {
        grid-template-columns: 1fr;
        display: grid;
      }

      .stats-grid,
      .detail-grid,
      .form-grid,
      .info-grid {
        grid-template-columns: 1fr;
      }

      .calendar-grid {
        gap: 0.35rem;
      }

      .calendar-day {
        min-height: 2.7rem;
      }

      .heatmap-header {
        display: grid;
      }

      .nav {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
